{
  "name": "databoost-sro",
  "version": "0.1.0",
  "description": "Thin TypeScript client for the DataBoost SRO HTTP ranking API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/databoost/dabo-sdks.git",
    "directory": "typescript"
  },
  "license": "UNLICENSED",
  "private": false,
  "keywords": [
    "databoost",
    "sro",
    "ranking"
  ],
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
